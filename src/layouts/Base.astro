---
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Nikolaus Schuetz — Principal Platform Engineer",
  description = "Principal Platform Engineer. I build Kubernetes platforms, Terraform providers, and the CI/CD that ships them — and contribute the results back upstream.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0b0d10" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfcfd" media="(prefers-color-scheme: light)" />
    <title>{title}</title>
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚙️</text></svg>"
    />
  </head>
  <body>
    <nav>
      <a href="/" class="brand">~/nikolauspschuetz</a>
      <span class="spacer"></span>
      <a href="/#work">Work</a>
      <a href="/blog">Writing</a>
      <a href="https://github.com/nikolauspschuetz">GitHub</a>
      <a href="https://www.linkedin.com/in/nikolaus-schuetz-49039737">LinkedIn</a>
    </nav>
    <main>
      <slot />
    </main>
    <footer>
      © Nikolaus Schuetz · built with Astro, deployed on Cloudflare — <a
        href="https://github.com/nikolauspschuetz/nikolauspschuetz.dev">source</a
      >
    </footer>
  </body>
</html>
