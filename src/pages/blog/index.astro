---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<Base title="Blog — Nikolaus Schuetz" description="Writing on platform engineering, open source, and AI-assisted development.">
  <h1>Blog</h1>
  {
    posts.length === 0 ? (
      <p class="tagline">Posts coming soon.</p>
    ) : (
      <ul class="post-list">
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.id}`}>{p.data.title}</a>
            <div class="meta">{fmt(p.data.date)}</div>
            <p class="desc">{p.data.description}</p>
          </li>
        ))}
      </ul>
    )
  }
</Base>
